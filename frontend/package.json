{
  "name": "changofilm-frontend",
  "private": true,
  "version": "1.11.1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "build:embedded": "vite build && node scripts/embed-dist.mjs",
    "preview": "vite preview",
    "gen:api": "python ../scripts/export_openapi.py && openapi-typescript openapi.json -o src/api/generated/schema.d.ts && orval --config orval.config.ts",
    "test": "vitest run",
    "golden:payload": "node scripts/golden-payload.mjs",
    "i18n:sync": "node scripts/sync-i18n.mjs",
    "e2e": "playwright test",
    "e2e:dev": "node scripts/e2e-dev.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-router": "^1.87.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "openapi-typescript": "^7.4.0",
    "orval": "^7.5.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
